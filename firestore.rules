rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Role helpers ────────────────────────────────────────────────────────
    // Firestore roles: cashier | admin | superadmin
    // UI labels:       Cashier | Warehouse | Admin

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return userDoc().role;
    }

    function isActive() {
      return userDoc().isActive == true;
    }

    /** Any active staff (Cashier / Warehouse / Admin) */
    function isStaff() {
      return isAuthenticated() && isActive()
        && getRole() in ['cashier', 'admin', 'superadmin'];
    }

    /** Cashier only — store till */
    function isCashierOnly() {
      return isAuthenticated() && isActive() && getRole() == 'cashier';
    }

    /** Warehouse ops + Admin (Firestore admin | superadmin) */
    function isWarehouseOps() {
      return isAuthenticated() && isActive()
        && getRole() in ['admin', 'superadmin'];
    }

    /** Full Admin (superadmin) */
    function isFullAdmin() {
      return isAuthenticated() && isActive() && getRole() == 'superadmin';
    }

    /** Cashier POS dual-write: only stock fields on books */
    function cashierBookStockUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['inStock', 'updatedAt']);
    }

    /** Self-profile edit: cannot escalate role or reactivate self */
    function selfProfileUpdate(userId) {
      return request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isActive', 'email', 'createdAt']);
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId || isWarehouseOps());
      allow create: if isFullAdmin();
      allow update: if isFullAdmin() || selfProfileUpdate(userId);
      allow delete: if isFullAdmin();
    }

    // ── Books (catalog) ─────────────────────────────────────────────────────
    // Cashiers: read + dual-write inStock on sale/return
    // Warehouse/Admin: full catalog create/update
    match /books/{bookId} {
      allow read: if isStaff();
      allow create: if isWarehouseOps();
      allow update: if isWarehouseOps()
        || (isCashierOnly() && cashierBookStockUpdate());
      allow delete: if isFullAdmin();
    }

    // ── Stock Transactions (append-only) ────────────────────────────────────
    match /stockTransactions/{txId} {
      allow read: if isWarehouseOps();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ── Customers ───────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read, create, update: if isStaff();
      allow delete: if isWarehouseOps();
    }

    // ── Sales ───────────────────────────────────────────────────────────────
    match /sales/{saleId} {
      allow read, create, update: if isStaff();
      allow delete: if isFullAdmin();
    }

    // ── Discounts ───────────────────────────────────────────────────────────
    match /discounts/{discountId} {
      allow read: if isStaff();
      allow create, update: if isWarehouseOps();
      allow delete: if isFullAdmin();
    }

    // ── Audit Logs (append-only) ────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isWarehouseOps();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ── Shift Closes (append-only) ──────────────────────────────────────────
    match /shiftCloses/{closeId} {
      allow read: if isWarehouseOps();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ── Daily Analytics ─────────────────────────────────────────────────────
    match /analytics/{docId} {
      allow read: if isWarehouseOps();
      allow write: if isStaff();
    }

    // ── Locations (warehouses) ──────────────────────────────────────────────
    // Three permanent: Main Warehouse / Backroom / Bookstore Floor
    match /warehouses/{warehouseId} {
      allow read: if isStaff();
      allow create, update: if isWarehouseOps();
      allow delete: if isFullAdmin();
    }

    // ── Cartons (boxes) ─────────────────────────────────────────────────────
    // Cashiers may read/scan; only warehouse ops create/update
    match /boxes/{boxId} {
      allow read: if isStaff();
      allow create, update: if isWarehouseOps();
      allow delete: if isFullAdmin();
    }

    // ── Book Inventory (per-location qty) ───────────────────────────────────
    // Cashiers: sale/return on Bookstore Floor
    // Warehouse: receive / transfer / put-on-sale / stocktake
    match /bookInventory/{bookId} {
      allow read, write: if isStaff();
    }

    // ── Transfers ───────────────────────────────────────────────────────────
    match /transfers/{transferId} {
      allow read: if isStaff();
      allow create, update: if isWarehouseOps();
      allow delete: if isFullAdmin();
    }

    // ── Inventory Movements (append-only) ───────────────────────────────────
    // Cashiers: sale / return · Warehouse: receive / transfer / put-on-sale
    match /inventoryMovements/{movementId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ── Carton barcode sequence counters ────────────────────────────────────
    match /counters/{counterId} {
      allow read, write: if isWarehouseOps();
    }

    // ── Shelf Locations ─────────────────────────────────────────────────────
    match /shelfLocations/{shelfId} {
      allow read: if isStaff();
      allow create, update: if isWarehouseOps();
      allow delete: if isFullAdmin();
    }

    // ── Stocktakes / Cycle count ────────────────────────────────────────────
    match /stocktakes/{stocktakeId} {
      allow read, create, update: if isWarehouseOps();
      allow delete: if isFullAdmin();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
