rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isSuperAdmin() {
      return isAuthenticated() && isActive() && getRole() == 'superadmin';
    }

    function isAdmin() {
      return isAuthenticated() && isActive() && (getRole() == 'admin' || getRole() == 'superadmin');
    }

    function isCashier() {  
      return isAuthenticated() && isActive() && (
        getRole() == 'cashier' || getRole() == 'admin' || getRole() == 'superadmin'
      );
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }

    // ── Books ──────────────────────────────────────────────────────────────
    match /books/{bookId} {
      allow read:           if isCashier();
      allow create, update: if isAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ── Stock Transactions (append-only — no update/delete ever) ────────────
    match /stockTransactions/{txId} {
      allow read:          if isAdmin();
      allow create:        if isCashier();   // cashiers create these during POS sales and returns
      allow update, delete: if false;
    }

    // ── Customers ──────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read:           if isCashier();
      allow create, update: if isCashier();
      allow delete:         if isAdmin();
    }

    // ── Sales ──────────────────────────────────────────────────────────────
    match /sales/{saleId} {
      allow read:   if isCashier();
      allow create: if isCashier();
      allow update: if isCashier();   // cashiers can update for returns; admins can void
      allow delete: if isSuperAdmin();
    }

    // ── Discounts ──────────────────────────────────────────────────────────
    match /discounts/{discountId} {
      allow read:           if isCashier();
      allow create, update: if isAdmin();
      allow delete:         if isSuperAdmin();
    }

    // ── Audit Logs (append-only — no update/delete ever) ───────────────────
    match /auditLogs/{logId} {
      allow read:          if isAdmin();
      allow create:        if isAuthenticated();
      allow update, delete: if false;
    }

    // ── Shift Closes (cashiers write, admins read) ─────────────────────────
    match /shiftCloses/{closeId} {
      allow read:          if isAdmin();
      allow create:        if isCashier();
      allow update, delete: if false;
    }

  }
}
